@using DevSkill.Inventory.Application.Features.Products.Commands
@model ProductAddCommand

@{
    ViewData["Title"] = "Add Product";
}

<!--begin::App Content Header-->
<div class="app-content-header">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <div class="col-sm-6"><h3 class="mb-0">Add Product</h3></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Add Product</li>
                </ol>
            </div>
        </div>
        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content Header-->
<!--begin::App Content-->
<div class="app-content">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row g-4">
            <!--begin::Col-->
            <div class="col-12">
                <partial name="_ResponsePartial" />

                </div>
            </div>
            <!--end::Col-->
            <!--begin::Col-->
            <div class="col-md-6">
                <!--begin::Quick Example-->
                <div class="card card-primary card-outline mb-4 ">
                    <!--begin::Header-->
                    <div class="card-header"><div class="card-title">Add a new product</div></div>
                    <!--end::Header-->
                    <!--begin::Form-->
                    <form asp-antiforgery="true" asp-area="Admin" asp-controller="Products" asp-action="Add" method="post">
                        <!--begin::Body-->
                    <div asp-validation-summary="All" class="text-danger"></div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label asp-for="Name" class="form-label">Product Name</label>
                                <input type="text"
                                       class="form-control"
                                       asp-for="Name"
                                       aria-describedby="nameHelp" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                                <div id="nameHelp" class="form-text">
                                    Enter the full product name including key specs (e.g., 'Intel Core i9-13900K 3.0 GHz 24-Core Processor')
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Price" class="form-label">Price</label>
                                <input type="number" class="form-control" asp-for="Price" step="0.01" aria-describedby="priceHelp" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                                <div id="priceHelp" class="form-text">Set the product price</div>
                            </div>



                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">Description</label>
                                <textarea class="form-control" asp-for="Description" rows="3" aria-describedby="descHelp"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                                <div id="descHelp" class="form-text">Write a short description</div>
                            </div>



                            <div class="mb-3">
                                <label asp-for="ManufactureDate" class="form-label">Manufacture Date</label>
                                <input type="date" class="form-control" asp-for="ManufactureDate" aria-describedby="dateHelp" />
                                <span asp-validation-for="ManufactureDate" class="text-danger"></span>
                                <div id="dateHelp" class="form-text">Select manufacture date</div>
                            </div>




                        </div>
                        <!--end::Body-->
                        <!--begin::Footer-->
                        <div class="card-footer">
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </div>
                        <!--end::Footer-->
                    </form>
                    <!--end::Form-->
                </div>
                <!--end::Quick Example-->

            </div>
            <!--end::Col-->

        </div>
        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content-->

@section Scripts
{
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}