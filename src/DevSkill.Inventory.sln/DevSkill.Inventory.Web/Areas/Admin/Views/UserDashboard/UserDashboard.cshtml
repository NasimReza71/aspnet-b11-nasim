@using DevSkill.Inventory.Web.Areas.Admin.Models.UserDashboardViewModel
@model UserDashboardViewModel

@{
    ViewData["Title"] = "Users";
}

@section Styles
{
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        .dashboard-card-simple {
            border-radius: 8px;
            min-height: 110px;
            padding: 16px 24px;
            display: flex;
            align-items: center;
            font-size: 1.07rem;
        }

            .dashboard-card-simple .dashboard-icon {
                font-size: 2rem;
                margin-right: 18px;
                color: #181818;
            }

            .dashboard-card-simple.bg-customer {
                background: #ffd6d6;
            }

            .dashboard-card-simple.bg-supplier {
                background: #eeffcf;
            }

            .dashboard-card-simple.bg-staff {
                background: #e6e6fa;
            }

            .dashboard-card-simple.bg-user {
                background: #fffdd6;
            }

        .dashboard-count {
            font-weight: bold;
            font-size: 1.1rem;
            margin-left: 2px;
        }

        .dashboard-page-title {
            font-size: 2rem;
            font-weight: 400;
            margin-top: 20px;
            margin-bottom: 0;
        }

        .dashboard-header-card {
            margin-bottom: 18px;
            border-radius: 8px;
        }
    </style>
}

<div class="container-fluid mt-2">
    <div class="row">
        <div class="col-12">
            <span class="dashboard-page-title">Users</span>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card dashboard-header-card">
                <div class="card-body py-2 px-3">
                    <span style="font-size: 1.1rem;">Users</span>
                </div>
            </div>
        </div>
    </div>
    <div class="row g-3">
        <div class="col-lg-3 col-md-6 col-12">
            <a href="/Admin/Customers/CustomerList" style="text-decoration:none;">
                <div class="dashboard-card-simple bg-customer">
                    <span class="dashboard-icon"><i class="bi bi-list"></i></span>
                    <span>
                        Customer<br />
                        <span class="dashboard-count">@Model.CustomerCount</span>
                    </span>
                </div>
            </a>
        </div>
        <div class="col-lg-3 col-md-6 col-12">
            <a href="/Admin/Suppliers/SupplierList" style="text-decoration:none;">
                <div class="dashboard-card-simple bg-supplier">
                    <span class="dashboard-icon"><i class="bi bi-list"></i></span>
                    <span>
                        Supplier<br />
                        <span class="dashboard-count">@Model.SupplierCount</span>
                    </span>
                </div>
            </a>
        </div>
        <div class="col-lg-3 col-md-6 col-12">
            <a href="/Admin/Staffs/StaffList" style="text-decoration:none;">
                <div class="dashboard-card-simple bg-staff">
                    <span class="dashboard-icon"><i class="bi bi-list"></i></span>
                    <span>
                        Staff / Employee<br />
                        <span class="dashboard-count">@Model.StaffCount</span>
                    </span>
                </div>
            </a>
        </div>
        <div class="col-lg-3 col-md-6 col-12">
            <a href="/Admin/Users/UserList" style="text-decoration:none;">
                <div class="dashboard-card-simple bg-user">
                    <span class="dashboard-icon"><i class="bi bi-list"></i></span>
                    <span>
                        User<br />
                        <span class="dashboard-count">@Model.UserCount</span>
                    </span>
                </div>
            </a>
        </div>
    </div>
</div>
