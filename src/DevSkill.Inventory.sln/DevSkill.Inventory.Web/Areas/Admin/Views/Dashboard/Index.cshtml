@{
    ViewData["Title"] = "Index";
}

@section Styles
{
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/apexcharts@3.37.1/dist/apexcharts.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jsvectormap@1.5.3/dist/css/jsvectormap.min.css" crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
}

<div class="app-content-header">
    <div class="container-fluid">

        <!-- Row 1 -->
        <div class="row">
            <div class="col-md-2 mb-3">
                <a href="/Admin/Customers/CustomerList" class="text-decoration-none">
                    <div class="card text-white position-relative" style="background-color: #ab47bc;">
                        <div class="card-body">
                            <h4 class="fw-bold">62</h4>
                            <h6 class="text-white-50">Total Customer</h6>
                            <i class="bi bi-people-fill fs-1 position-absolute bottom-0 end-0 p-2 opacity-25"></i>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-2 mb-3">
                <a href="/Admin/Products/ProductList" class="text-decoration-none">
                    <div class="card text-white position-relative" style="background-color: #7b1fa2;">
                        <div class="card-body">
                            <h4 class="fw-bold">37</h4>
                            <h6 class="text-white-50">Total Product</h6>
                            <i class="bi bi-cart-plus fs-1 position-absolute bottom-0 end-0 p-2 opacity-25"></i>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-2 mb-3">
                <a href="/Admin/Suppliers/SupplierList" class="text-decoration-none">
                    <div class="card text-white position-relative" style="background-color: #0d47a1;">
                        <div class="card-body">
                            <h4 class="fw-bold">15</h4>
                            <h6 class="text-white-50">Total Supplier</h6>
                            <i class="bi bi-person-lines-fill fs-1 position-absolute bottom-0 end-0 p-2 opacity-25"></i>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-3 mb-3">
                <a href="/Admin/Sales/SaleList" class="text-decoration-none">
                    <div class="card text-white position-relative" style="background-color: #2196f3;">
                        <div class="card-body">
                            <h4 class="fw-bold">1,015,153.50</h4>
                            <h6 class="text-white-50">Total Sales</h6>
                            <i class="bi bi-bag-check-fill fs-1 position-absolute bottom-0 end-0 p-2 opacity-25"></i>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card text-white position-relative" style="background-color: #7cb342;">
                    <div class="card-body">
                        <h4 class="fw-bold">3,244,518.00</h4>
                        <h6 class="text-white-50">STOCK - Purchase Value</h6>
                        <i class="bi bi-cash-coin fs-1 position-absolute bottom-0 end-0 p-2 opacity-25"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 2 -->
        <div class="row">
            <div class="col-md-2 mb-3">
                <div class="card text-white position-relative" style="background-color: #ec407a;">
                    <div class="card-body">
                        <h4 class="fw-bold">0.00</h4>
                        <h6 class="text-white-50">Today Sales</h6>
                        <i class="bi bi-briefcase-fill fs-1 position-absolute bottom-0 end-0 p-2 opacity-25"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-3">
                <div class="card text-white position-relative" style="background-color: #8e24aa;">
                    <div class="card-body">
                        <h4 class="fw-bold">0.00</h4>
                        <h6 class="text-white-50">Todays Purchase</h6>
                        <i class="bi bi-cart-fill fs-1 position-absolute bottom-0 end-0 p-2 opacity-25"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-3">
                <div class="card text-white position-relative" style="background-color: #1565c0;">
                    <div class="card-body">
                        <h4 class="fw-bold">0.00</h4>
                        <h6 class="text-white-50">Today Expense</h6>
                        <i class="bi bi-funnel-dollar fs-1 position-absolute bottom-0 end-0 p-2 opacity-25"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card text-white position-relative" style="background-color: #29b6f6;">
                    <div class="card-body">
                        <h4 class="fw-bold">0.00</h4>
                        <h6 class="text-white-50">Todays Income</h6>
                        <i class="bi bi-currency-dollar fs-1 position-absolute bottom-0 end-0 p-2 opacity-25"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card text-white position-relative" style="background-color: #558b2f;">
                    <div class="card-body">
                        <h4 class="fw-bold">4,443,646.00</h4>
                        <h6 class="text-white-50">STOCK - Sell Value</h6>
                        <i class="bi bi-coin fs-1 position-absolute bottom-0 end-0 p-2 opacity-25"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 3: Top Sale Products & Low Stock -->
        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card" style="background-color: #e3f2fd;">
                    <div class="card-header bg-transparent text-center fw-bold fs-5">Top Sale Products</div>
                    <div class="card-body d-flex justify-content-around align-items-start flex-wrap">
                        <div class="card text-center p-3 m-2" style="width: 10rem;">
                            <i class="bi bi-cart-fill text-success fs-1"></i>
                            <strong class="mt-2">FEED 25/50</strong>
                            <div>110 BOSTA</div>
                        </div>
                        <div class="card text-center p-3 m-2" style="width: 10rem;">
                            <i class="bi bi-stars text-primary fs-1"></i>
                            <strong class="mt-2">Skm 1-7</strong>
                            <div>46 Box</div>
                        </div>
                        <div class="card text-center p-3 m-2" style="width: 10rem;">
                            <i class="bi bi-cart-fill text-success fs-1"></i>
                            <strong class="mt-2">MOTA VUSI</strong>
                            <div>30 BOSTA</div>
                        </div>
                    </div>
                    <div class="card-footer text-center bg-transparent">
                        <a href="#" class="btn btn-primary btn-sm">View More</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card" style="background-color: #f3e5f5;">
                    <div class="card-header bg-transparent text-center fw-bold fs-5">Low Stock Products</div>
                    <div class="card-body p-0">
                        <table class="table table-bordered text-center mb-0">
                            <thead style="background-color: #e1bee7;">
                                <tr>
                                    <th>SN.</th>
                                    <th>Name</th>
                                    <th>Quantity</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="background-color: #ede7f6;">
                                    <td>1</td>
                                    <td>T-Shart</td>
                                    <td>-9</td>
                                </tr>
                                <tr style="background-color: #ede7f6;">
                                    <td>2</td>
                                    <td>MOTA VUSI</td>
                                    <td>-10</td>
                                </tr>
                                <tr style="background-color: #ede7f6;">
                                    <td>3</td>
                                    <td>Aes</td>
                                    <td>0</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer text-center bg-transparent">
                        <a href="#" class="btn btn-purple text-white btn-sm" style="background-color: #6a1b9a;">View More</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 4: Charts -->
        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">Last 7 Days' Sales (Products)</div>
                    <div class="card-body">
                        <div id="last7DaysSales" style="height: 300px;"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">Profit Loss Pie Chart</div>
                    <div class="card-body">
                        <div id="profitLossPieChart" style="height: 300px;"></div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.37.1/dist/apexcharts.min.js"></script>
    <script>
        var salesChart = new ApexCharts(document.querySelector("#last7DaysSales"), {
            chart: { type: 'bar', height: 300 },
            series: [{ name: 'Sales', data: [35, 40, 28, 52, 60, 48, 70] }],
            xaxis: { categories: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'] }
        });
        salesChart.render();

        var pieChart = new ApexCharts(document.querySelector("#profitLossPieChart"), {
            chart: { type: 'pie', height: 300 },
            series: [45, 25, 30],
            labels: ['Profit', 'Loss', 'Others']
        });
        pieChart.render();
    </script>
}
