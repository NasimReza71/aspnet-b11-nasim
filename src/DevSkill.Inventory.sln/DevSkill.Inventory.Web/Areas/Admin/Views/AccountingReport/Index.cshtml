@model List<DevSkill.Inventory.Web.Areas.Admin.Models.AccountingReportModels.AccountingReportCardViewModel>

@{
    ViewBag.Title = "Accounting Report";
}

<div class="container-fluid">
    <h2>Accounting Report</h2>
    <div class="card mt-3">
        <div class="card-header">
            Accounting Report
        </div>
        <div class="card-body">
            <div class="mb-3">
                <input type="text" class="form-control" placeholder="Search..." />
            </div>
            <div class="row g-3">
                @foreach (var card in Model)
                {
                    <div class="col-md-3">
                        <div class="card text-dark @card.BgColorClass h-100">
                            <div class="card-body d-flex align-items-center">
                                <i class="bi @card.Icon me-3 fs-2"></i>
                                <div>
                                    <div>@card.Title</div>
                                    @if (!string.IsNullOrEmpty(card.Value))
                                    {
                                        <div class="fw-bold">@card.Value</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
