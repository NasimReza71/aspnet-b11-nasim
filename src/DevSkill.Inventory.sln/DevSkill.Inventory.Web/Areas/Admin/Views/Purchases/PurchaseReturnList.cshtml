@using DevSkill.Inventory.Web.Areas.Admin.Models.PurchaseModels
@model PurchaseReturnListModel
@{
    ViewData["Title"] = "PurchaseReturnList";
}

@section Styles
{
    <link rel="stylesheet" href="https://cdn.datatables.net/2.2.2/css/dataTables.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.0.2/css/buttons.dataTables.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />

    <style>
        .dt-button {
            background-color: #007bff !important;
            color: white !important;
            border: 1px solid #007bff !important;
            transition: all 0.3s ease;
        }

            .dt-button:hover {
                background-color: white !important;
                color: #007bff !important;
            }
    </style>
   
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6"><h3 class="mb-0">Purchase Return</h3></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Purchase Returns </li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-search mr-1"></i>Search Purchase Return</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool" data-card-widget="collapse">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-3">
                            <label>Return Invoice</label>
                            <input type="text" asp-for="SearchItem.ReturnInvoice" class="form-control" />
                        </div>
                        <div class="col-sm-3">
                            <label>Supplier</label>
                            <input type="text" asp-for="SearchItem.Supplier" class="form-control" />
                        </div>
                        <div class="col-sm-3">
                            <label>Quantity</label>
                            <input type="number" asp-for="SearchItem.Quantity" class="form-control" />
                        </div>
                        <div class="col-sm-3">
                            <label>Total Price</label>
                            <input type="number" asp-for="SearchItem.TotalPrice" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button id="searchButton" type="button" class="btn btn-primary float-right">Search</button>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Purchase Return List</h3></div>
                    <div class="card-body">
                        <partial name="_ResponsePartial" />
                        <partial name="_ModalPartial" />
                        <table id="purchaseReturns" class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>#SN.</th>
                                    <th>Date</th>
                                    <th>R-Inv. No.</th>
                                    <th>Supplier</th>
                                    <th>Quantity</th>
                                    <th>Total</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                            <tfoot>
                                <tr>
                                    <th>#SN.</th>
                                    <th>Date</th>
                                    <th>R-Inv. No.</th>
                                    <th>Supplier</th>
                                    <th>Quantity</th>
                                    <th>Total</th>
                                    <th>Actions</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts
{
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.print.min.js"></script>
    <script>
        $(function () {
            $("#purchaseReturns").DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                lengthChange: true,
                autoWidth: false,
                lengthMenu: [
                    [10, 25, 50, -1],
                    [10, 25, 50, 'All']
                ],
                layout: {
                    topStart: 'buttons',
                    topEnd: 'search',
                },
                        buttons: [
            {
                extend: 'copy',
                text: '<i class="fas fa-copy"></i> Copy'
            },
            {
                extend: 'excel',
                text: '<i class="fas fa-file-excel"></i> Excel'
            },
            {
                extend: 'csv',
                text: '<i class="fas fa-file-csv"></i> CSV'
            },
            {
                extend: 'pdf',
                text: '<i class="fas fa-file-pdf"></i> PDF'
            },
            {
                extend: 'print',
                text: '<i class="fas fa-print"></i> Print'
            }
        ],

                ajax: {
                    url: "/Admin/Purchases/GetPurchaseReturnsJsonData",
                    type: "POST",
                    contentType: "application/json",
                    dataType: "json",
                    data: function (d) {
                        d.SearchItem = {
                            ReturnInvoice: $("#SearchItem_ReturnInvoice").val(),
                            Supplier: $("#SearchItem_Supplier").val(),
                            Quantity: $("#SearchItem_Quantity").val() === "" ? null : $("#SearchItem_Quantity").val(),
                            TotalPrice: $("#SearchItem_TotalPrice").val() === "" ? null : $("#SearchItem_TotalPrice").val()
                        };
                        return JSON.stringify(d);
                    },
                },
                columnDefs: [
                    {
                        orderable: false,
                        targets: 6,
                        render: function (data, type, row) {
                            return `
                                <button class="btn btn-info btn-sm" onclick="window.location.href='/admin/purchasereturns/view/${data}'"><i class="fas fa-eye"></i> View</button>
                                <button class="btn btn-danger btn-sm show-bs-modal" data-id="${data}"><i class="fas fa-trash"></i> Delete</button>`;
                        }
                    }
                ]
            });

            $('#purchaseReturns').on('click', '.show-bs-modal', function () {
                let id = $(this).data("id");
                let deleteModal = $("#modal-delete");
                deleteModal.find('.modal-body p').text('Are you sure you want to delete this purchase return?');
                $('#delete-id').val(id);
                $('#delete-form').attr('action', '/admin/purchasereturns/delete');
                deleteModal.modal('show');
            });

            $('#delete-button').click(function () {
                $('#delete-form').submit();
            });

            $("#searchButton").click(function () {
                $('#purchaseReturns').DataTable().ajax.reload(null, false);
            });
        });
    </script>
}

