@model DevSkill.Inventory.Web.Areas.Admin.Models.ProductPlusModels.ProductPlusAddViewModel

<!-- Modal for New Product -->

<div id="modal-new-productplus" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="newProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form asp-action="Add" asp-controller="ProductPlus" asp-area="Admin" method="post" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title" id="newProductModalLabel">Add New Product</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body row">
                    <div class="col-md-6 form-group">
                        <label>Product Code</label>
                        <input asp-for="ProductCode" class="form-control" placeholder="Enter product code" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Product Name</label>
                        <input asp-for="ProductName" class="form-control" placeholder="Enter product name" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Category</label>
                        <input asp-for="Category" class="form-control" placeholder="Enter category" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Purchase Price</label>
                        <input asp-for="PurchasePrice" class="form-control" placeholder="Enter purchase price" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label>MRP</label>
                        <input asp-for="MRP" class="form-control" placeholder="Enter MRP" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Wholesale Price</label>
                        <input asp-for="WholesalePrice" class="form-control" placeholder="Enter wholesale price" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Stock Quantity</label>
                        <input asp-for="StockQuantity" class="form-control" placeholder="Enter stock quantity" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Low Stock Threshold</label>
                        <input asp-for="LowStockThreshold" class="form-control" placeholder="Enter low stock threshold" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Damage Stock</label>
                        <input asp-for="DamageStock" class="form-control" placeholder="Enter damage stock" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Product Image</label>
                        <input asp-for="ProductImage" type="file" class="form-control" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Add Product</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>
